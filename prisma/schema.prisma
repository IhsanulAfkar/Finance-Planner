generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int                   @id @default(autoincrement())
  name                  String
  email                 String                @unique
  password              String
  is_verified           Boolean               @default(false)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  verificationCodes     VerificationCode[]
  chatHistories         ChatHistory[]
  transactions          Transaction[]
  receipts              Receipt[]
  savingsGoals          SavingsGoal[]
  accounts              Account[]
  transactionCategories TransactionCategory[]
  savingsCategories     SavingsCategory[]
}

model VerificationCode {
  id         Int      @id @default(autoincrement())
  email      String
  code       String
  expires_at DateTime
  created_at DateTime @default(now())

  user_id Int?
  user    User? @relation(fields: [user_id], references: [id])

  @@index([email])
}

model TransactionCategory {
  id         Int             @id @default(autoincrement())
  user_id    Int
  name       String // e.g. Food, Transport
  color      String? // for charts
  icon       String?
  type       TransactionType
  created_at DateTime        @default(now())

  user         User          @relation(fields: [user_id], references: [id])
  transactions Transaction[]

  @@unique([user_id, name, type])
}

enum AccountType {
  SAVINGS
  INVESTMENT
  EMERGENCY
  CASH
  OTHER
}

enum FrequencyType {
  ONE_TIME
  WEEKLY
  MONTHLY
  YEARLY
}

model Account {
  id          Int         @id @default(autoincrement())
  user_id     Int
  type        AccountType
  balance     Float       @default(0)
  description String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user                      User                       @relation(fields: [user_id], references: [id])
  transactions              Transaction[]
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
}

model Transaction {
  id          Int             @id @default(autoincrement())
  user_id     Int
  account_id  Int
  source      String?
  category_id Int?
  amount      Float
  type        TransactionType
  description String?
  date        DateTime
  frequency   FrequencyType   @default(ONE_TIME)

  created_at DateTime @default(now())

  user                      User                       @relation(fields: [user_id], references: [id])
  category                  TransactionCategory?       @relation(fields: [category_id], references: [id])
  account                   Account                    @relation(fields: [account_id], references: [id])
  savingsContributions      SavingsContribution[]
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
  receipts                  Receipt[]

  @@index([user_id])
  @@index([account_id])
  @@index([category_id])
  @@index([date])
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Receipt {
  id             Int      @id @default(autoincrement())
  user_id        Int
  merchant       String
  total          Float
  date           DateTime
  image_url      String?
  is_verified    Boolean  @default(false)
  transaction_id Int
  created_at     DateTime @default(now())

  user        User          @relation(fields: [user_id], references: [id])
  transaction Transaction   @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  items       ReceiptItem[]
}

model ReceiptItem {
  id         Int    @id @default(autoincrement())
  receipt_id Int
  name       String
  price      Float?

  receipt Receipt @relation(fields: [receipt_id], references: [id])
}

model SavingsCategory {
  id           Int           @id @default(autoincrement())
  name         String
  user_id      Int
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  user         User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  savingsGoals SavingsGoal[]
}

model SavingsGoal {
  id             Int                   @id @default(autoincrement())
  user_id        Int
  title          String
  category_id    Int
  target_amount  Float
  monthly_target Float?
  target_date    DateTime?
  current_amount Float                 @default(0)
  created_at     DateTime              @default(now())
  category       SavingsCategory       @relation(fields: [category_id], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [user_id], references: [id])
  contributions  SavingsContribution[]
}

model SavingsContribution {
  id             Int         @id @default(autoincrement())
  goal_id        Int
  transaction_id Int
  amount         Float
  date           DateTime
  transaction    Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)
  goal           SavingsGoal @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  chatExecutionHistoryItems ChatExecutionHistoryItem[]

  @@index([goal_id])
  @@index([transaction_id])
}

model ChatHistory {
  id                     Int                    @id @default(autoincrement())
  user_id                Int
  role                   String
  content                String
  user                   User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at             DateTime               @default(now())
  chatExecutionHistories ChatExecutionHistory[]
}

model ChatExecutionHistory {
  id                        Int                        @id @default(autoincrement())
  chat_id                   Int
  method                    String
  payload                   Json?
  chat                      ChatHistory                @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  created_at                DateTime                   @default(now())
  chatExecutionHistoryItems ChatExecutionHistoryItem[]
}

model ChatExecutionHistoryItem {
  id                      Int                  @id @default(autoincrement())
  execution_id            Int
  transaction_id          Int?
  savings_contribution_id Int?
  account_id              Int?
  chatExecutionHistory    ChatExecutionHistory @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  transaction             Transaction?         @relation(fields: [transaction_id], references: [id], onDelete: SetNull)
  savingContribution      SavingsContribution? @relation(fields: [savings_contribution_id], references: [id], onDelete: SetNull)
  account                 Account?             @relation(fields: [account_id], references: [id], onDelete: SetNull)
}
